# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Debe ser de un dominio verificado en Resend.
# Con "onboarding@resend.dev" (dominio de pruebas) Resend solo entrega al correo dueño de la cuenta.
MAIL_FROM="ShopCommerce <onboarding@resend.dev>"

# Base de datos en Supabase: Project Settings → Database → Connection string → "Session pooler".
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base (no la de tu cuenta de Supabase).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# URL pública donde corre este servidor. Se usa para armar el link de activación.
APP_URL=http://localhost:4099
PORT=4099

# Horas de validez del link de activación
ACTIVATION_TTL_HOURS=24

# Encargado(s) que reciben las solicitudes de cotización/demo (separados por coma)
SOLICITUDES_TO=ventas@tudominio.cl
